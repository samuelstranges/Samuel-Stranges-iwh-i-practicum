doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Update
        a(href='//localhost:3000/') Return to the homepage

        form#theForm
            p name
            input(name="name" id="name" type="text")
            p Age
            input(name="age" id="age" type="number")
            p Sickly?
            input(name="sickly" id="sickly" type="text")
            br
            button(type="submit") Submit

        script.
            // Needed help figuring out what to do with Claude for JS in pug
            document.getElementById('theForm').addEventListener('submit', function(e) {

                // Override refreshing page with arguments passed rather than doing something with them
                e.preventDefault();

                // Pull values into constants to be returned in fetch method body
                const pet_name = document.getElementById('name').value;
                const name = document.getElementById('name').value;
                const age = document.getElementById('age').value;
                const sickly = document.getElementById('sickly').value;

                // Call update-cobj POST method defined by our server (that calls Hubspot using axios)
                fetch(
                    '/update-cobj',
                    {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ pet_name, name, age, sickly })
                    }
                )
                // Return the script: "ok" as a JSON parsed response body
                .then(function(res) { return res.json(); })
                .then(function(data) { window.location.href = '/'; });
            });
