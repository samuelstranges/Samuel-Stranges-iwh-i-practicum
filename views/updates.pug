doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Update
        a(href='//localhost:3000/') Return to the homepage

        form#theForm
            p name
            input(name="name" id="name" type="text")
            p Age
            input(name="age" id="age" type="number")
            p Sickly?
            input(name="sickly" id="sickly" type="text")
            br
            button(type="submit") Submit

        script.
            // Needed help figuring out what to do with Claude for JS in pug
            document.getElementById('theForm').addEventListener('submit', function(e) {

                e.preventDefault();

                const name = document.getElementById('name').value;
                const age = document.getElementById('age').value;
                const sickly = document.getElementById('sickly').value;

                console.log(name, age, sickly);

                fetch(
                    '/update-cobj',
                    {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name, age, sickly })
                    }
                )
                .then(res => res.json())
                .then(data => console.log('New record:', data))
                .catch(err => console.error('Error:', err));
            });
