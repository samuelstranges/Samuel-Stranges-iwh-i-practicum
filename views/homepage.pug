doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Custom Object table
        a(href='//localhost:3000/updates') Add/update to this table
        table()
            thead
                tr
                    th Name
                    th Age
                    th Sickly?
            tbody
                each pet in data
                    tr
                        td #{pet.properties.name}
                        td #{pet.properties.age}
                        td #{pet.properties.sickly}
